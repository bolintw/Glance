# The target lives in sdkconfig, which isn't in git; without this line a
# fresh checkout (the release workflow) builds for the plain ESP32.
CONFIG_IDF_TARGET="esp32s3"

# Board: eCalendar V3.0, the only one (main/board.hpp): ESP32-S3-WROOM-1-N8,
# 8MB flash, no PSRAM. GPIO35-37 stay free for a future module with octal
# PSRAM.
CONFIG_SPIRAM=n

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Two 3MB OTA app slots + on-chip storage (see partitions.csv). The default
# single-app table only gives a 1MB app, which WiFi + NTP alone already
# fills to ~78% -- no room for TLS or CJK fonts.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# app_main runs the TLS handshake for the calendar fetch directly; the
# default 3.5KB main task stack isn't enough for mbedtls.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# calendar.google.com sends a cross-signed GTS Root R4 (issued by GlobalSign
# Root CA, which is no longer in the bundle). GTS Root R4 itself is in the
# bundle, but without this the handshake fails with -0x3000
# (MBEDTLS_ERR_X509_FATAL_ERROR). Costs ~700 bytes of heap.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# No random 0-5s wait before the first NTP request (RFC 4330's spread for
# many devices powered up at once): it made the clock sync take 0.4-4.7s,
# the most variable step of a refresh (eight runs on V2.1, 2026-10-16).
CONFIG_LWIP_SNTP_STARTUP_DELAY=n

# Precomputed curve tables in flash (~29KB) speed up the fixed-point part of
# the TLS handshake's elliptic-curve math, which the ESP32-S3 has no
# accelerator for: connecting to a calendar took ~2.67s.
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y

# 240MHz rather than 160: the handshake's curve math is CPU-bound. Four
# calendars on V3.0 (2026-10-25, three runs each): connecting 1.61s instead
# of 2.09s apiece, about 2s off a run that takes some 20s awake.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Both boards have a 32.768kHz crystal on GPIO15/16 (U2). The default internal
# RC oscillator drifts noticeably with temperature, which adds up over a
# day of deep sleep between refreshes.
CONFIG_RTC_CLK_SRC_EXT_CRYS=y

# OTA updates (components/ota_update): a fresh update must mark itself valid
# after a successful run, or the bootloader rolls back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The board's only serial port is the chip's native USB (no UART bridge),
# so make it the primary console: output is the same, and stdin reads from
# it too (the development serial commands, GLANCE_DEV_SERIAL_COMMANDS). As
# the default secondary console it could only write.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# A task that hogs the CPU long enough to starve the idle task (5 s) is a
# bug: reboot instead of just logging it, so the run can start over.
CONFIG_ESP_TASK_WDT_PANIC=y
