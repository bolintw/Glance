# Development settings, layered last on top of sdkconfig.defaults, e.g. for
# a new board's first checks (tools/board/bringup.py):
#   idf.py -B build-dev -D SDKCONFIG=build-dev/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.dev" build
# Button commands and `glance hw` on the USB serial console; stays awake
# between refreshes, so the console doesn't disappear into deep sleep.
CONFIG_GLANCE_DEV_SERIAL_COMMANDS=y
CONFIG_GLANCE_DEEP_SLEEP=n
