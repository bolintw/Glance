menu "Glance Updates"

    config GLANCE_OTA_RELEASE_URL
        string "Where releases are published"
        default "https://github.com/bolintw/Glance/releases/latest/download"
        help
            The latest release's download directory (published by
            .github/workflows/release.yml). Each board reads its own update
            manifest there (board::kOtaManifest), so a device never installs
            a build for another board. Only release builds -- version
            vX.Y.Z, from firmware/version.txt -- ever update themselves; a
            development build never does.

endmenu
